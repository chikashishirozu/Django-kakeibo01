# このファイルを .env にコピーして値を書き換える（.env は Git に入れない）
# ※ サーバーの環境変数として設定した場合は、そちらが .env より優先される

DJANGO_SECRET_KEY='python -c "from django.core.management.utils import get_random_secret_key as g; print(g())" で生成して貼る'
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com

# --- HTTPS で公開する場合のみ True（自宅LANなど HTTP のままなら False） ---
USE_HTTPS=False
# HSTS の秒数。3600 から始めて段階的に延ばす（86400 → 2592000 → 31536000）
SECURE_HSTS_SECONDS=3600
# Render / Heroku / nginx など、リバースプロキシの後ろで動かす場合は True
BEHIND_PROXY=False
# HTTPS ドメインから POST する場合（例: https://example.com）
CSRF_TRUSTED_ORIGINS=

# --- キー交換の移行期間だけ、旧キーを入れる（全員ログアウトを避けられる） ---
SECRET_KEY_FALLBACKS=

# --- ユーザー登録画面（/accounts/signup/）---
# True: ログイン画面に「新規登録」リンクを出す / False: 登録画面を閉じる（404）
# 外部に公開するなら、家族の登録が済んだあと False にすること
ALLOW_SIGNUP=True
