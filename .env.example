# Copy this file to .env :   cp .env.example .env
# (.env is ignored by Git. Real environment variables take priority over .env.)

# ---- Local development (defaults) ----------------------------------------
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Show the "Sign up" link on the login page. Set to False to close sign-up.
ALLOW_SIGNUP=True

# ---- Production (uncomment and edit; see README "Deployment notes") ------
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_SECRET_KEY='paste-the-generated-key-here'
# DEBUG=False
# ALLOWED_HOSTS=example.com,www.example.com
# USE_HTTPS=True                 # keep False if you serve plain HTTP (e.g. home LAN)
# SECURE_HSTS_SECONDS=3600       # raise gradually: 86400 -> 2592000 -> 31536000
# BEHIND_PROXY=True              # when running behind Render / Heroku / nginx
# CSRF_TRUSTED_ORIGINS=https://example.com
# SECRET_KEY_FALLBACKS=          # old key(s) during key rotation
# ALLOW_SIGNUP=False             # close sign-up after your family has registered
